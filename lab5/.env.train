# ==============================================================================
# Konfiguracja usługi treningowej (Lab 5 - Zadanie 2)
# ==============================================================================

# Ścieżka do pliku z danymi wejściowymi (zamontowanego w kontenerze przez wolumen)
DATA_PATH=data/wine.csv

# Nazwa zbioru danych
DATASET_NAME=wine

# Parametry podziału zbioru
TEST_SIZE=0.2
RANDOM_SEED=42

# Katalogi i ścieżki zapisu artefaktów (montowane jako wolumeny z hosta)
DATA_DIR=data
MODELS_DIR=models
MODEL_PATH=models/model.joblib
RESULTS_PATH=wyniki.txt

# Wybór algorytmu i hiperparametry
MODEL_TYPE=logistic_regression
MAX_ITER=1000
N_ESTIMATORS=100

# Włączenie pełnego potoku: trening + ewaluacja (Zadanie 3)
RUN_EVALUATE=true

# Konfiguracja serwera statusu na potrzeby komunikacji między usługami i weryfikacji w 'docker stats' (Zadanie 4 i 6)
STATUS_SERVER_PORT=5000
KEEP_ALIVE_SECONDS=45
